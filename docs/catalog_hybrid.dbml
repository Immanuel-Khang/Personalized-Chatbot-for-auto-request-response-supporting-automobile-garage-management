Project garage_catalog_hybrid {
  database_type: 'PostgreSQL'
  Note: '''Đề xuất danh mục xe dạng lai, thay bảng tạm `catalog` (xem models.py: "Đợt 2").
  Nguồn: GarageChatbotDocs/CKD_MASTER_PRODUCT_DATABASE.csv (65 dòng, ~42 cột có dữ liệu) + hai file Foton Specs.
  Nguyên tắc: cột có kiểu cho thứ bot lọc/so sánh/hiển thị; JSONB cho phần dài đuôi; giữ chuỗi gốc để parse lại.
  Quy ước theo app/db/models.py: timestamptz UTC, mã trạng thái là varchar + CHECK (không native ENUM, không mã smallint).
  updated_at do ứng dụng cập nhật (onupdate), không trigger.
  NULL = chưa biết. Dấu "-" trong nguồn là NULL, KHÔNG phải false/0.
  Không tự sửa giá trị nghi ngờ (Axle_Ratio 4333, Displacement 2.493, MSRP 819180...): giữ chuỗi gốc, ghi data_issues.
  Chưa có bảng tồn kho, tài chính, bảo hành, chi phí vận hành, marketing, use case: nguồn đang rỗng.
  Thêm bằng migration khi có dữ liệu. Giá đại lý/giá tối thiểu/biên lợi nhuận cũng chưa có (xem ghi chú ở product_prices).'''
}

// ============================================================
// ĐỊNH DANH
// ============================================================

Table brands {
  id smallint [pk, increment]
  name varchar(80) [not null, unique, note: 'Tên chuẩn đã trim, ví dụ ISUZU, DOTHANH.']
  aliases text[] [not null, default: '{}', note: 'Cách viết khác trong nguồn: "ISUZU " (thừa khoảng trắng), "ĐÔ THÀNH" -> DOTHANH. Map có chủ đích khi import, không đoán.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table vehicle_models {
  id integer [pk, increment]
  brand_id smallint [not null, ref: > brands.id]
  name varchar(120) [not null, note: 'Tên dòng xe nhóm các cấu hình, ví dụ Aumark-9T, Linker T2-6.5. Cấu hình cụ thể (wheelbase, tải trọng) nằm ở products.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes { (brand_id, name) [unique] }
  Note: 'Dòng nguồn thiếu tên model (DONGBEN dòng 73) KHÔNG tạo model giả: để products.model_id NULL và status DRAFT.'
}

// ============================================================
// SẢN PHẨM (khớp contract Product: id, kind, name, list_price_vnd, price_as_of, specs)
// ============================================================

Table products {
  id integer [pk, increment]
  kind varchar(10) [not null, check: `kind IN ('CAR', 'TRUCK', 'PART')`, note: 'Giữ đúng giá trị DbProductService.VEHICLE_KINDS đang dùng.']
  name varchar(200) [not null, note: 'Tên hiển thị VÀ để tra bằng ILIKE. Quy tắc như data/catalog.json: "<HÃNG> <Model> (WB <wheelbase>)" khi cùng model có nhiều wheelbase; hậu tố "Chassis"/"Thùng mui bạt" khi cơ sở giá khác nhau. find_model yêu cầu khớp mọi từ nên tên phải ổn định.']
  aliases text[] [not null, default: '{}', note: 'Tên khác cùng sản phẩm, ví dụ "MILER-4.5T" cho "AUMARK-X-4.5T". find_model cần tìm cả cột này.']
  brand_id smallint [ref: > brands.id, note: 'NULL với PART nếu không rõ hãng.']
  model_id integer [ref: > vehicle_models.id]
  status varchar(10) [not null, default: 'DRAFT', check: `status IN ('DRAFT', 'ACTIVE', 'RETIRED')`, note: 'Chỉ ACTIVE mới được bot trả lời. DRAFT: thiếu định danh (dòng 73), dòng nghi trùng, hoặc chưa duyệt.']
  video_url varchar(500) [note: 'Tạm giữ để khớp catalog cũ; có product_media thì bỏ cột này.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (kind, status)
    model_id
    brand_id
    name [note: 'Cân nhắc GIN pg_trgm cho ILIKE khi catalog lớn; 65 dòng chưa cần.']
  }
  Note: 'Không UNIQUE theo (brand, model) hay name: cùng model có nhiều cấu hình (Linker T2-6.5 có payload 3490 và 1990). Dòng trùng hoàn toàn (HINO XZU720 dòng 34/41) gộp thành MỘT product, hai dòng product_sources.'
}

// 1:1 với products có kind CAR/TRUCK. Cột có kiểu = thứ bot lọc/so sánh. Đơn vị nằm trong tên cột.
Table vehicle_specs {
  product_id integer [pk, ref: - products.id]
  vehicle_type varchar(40) [note: 'Chuỗi nguồn đã trim: "Ô tô tải có mui", "Ô tô sát xi tải", "Ô tô chassis", "Ô tô tải". "chassis" và "sát xi" chưa chứng minh là một: giữ nguyên.']
  assembly varchar(3) [check: `assembly IN ('CKD', 'CBU')`, note: 'NULL nếu nguồn không nêu. Nguồn chỉ có 1 dòng CKD (WONDER-2.5T); không suy cho dòng còn lại.']
  wheel_formula varchar(12) [note: '4x2R, 6x4... là mã, không phải số.']
  seats smallint [check: `seats > 0`]
  curb_mass_kg integer [check: `curb_mass_kg > 0`]
  curb_mass_basis varchar(40) [note: '"chassis", "vehicle"... theo đúng nguồn ("3750 (chassis)"). Không suy từ vehicle_type.']
  payload_kg integer [check: `payload_kg >= 0`, note: 'Chỉ điền khi có đúng một giá trị. "990/1210": để NULL, đưa phương án vào spec_extra.load_alternatives.']
  gvm_kg integer [check: `gvm_kg > 0`, note: 'Tổng tải cho phép. Nhiều phương án ("3490/4300/4990") làm như payload_kg; không ghép cặp với payload.']
  wheelbase_mm integer [check: `wheelbase_mm > 0`, note: 'Xe 2 trục. Nhiều trục (CBU "1800 + 3300 + 1400") để NULL, chuỗi nằm ở spec_extra.axle_spacings_mm.']
  length_mm integer [check: `length_mm > 0`]
  width_mm integer [check: `width_mm > 0`]
  height_mm integer [check: `height_mm > 0`]
  dims_basis varchar(20) [note: '"chassis" nếu nguồn ghi (7440 x 2385 x 2515 (chassis)). Không CHECK length = wheelbase + FOH + ROH: nguồn có chỗ lệch.']
  ground_clearance_mm integer [check: `ground_clearance_mm > 0`]
  turning_radius_m numeric(5,2) [check: `turning_radius_m > 0`, note: 'Nguồn dùng dấu phẩy thập phân ("8,63").']
  fuel_tank_l smallint [check: `fuel_tank_l > 0`, note: 'Nguồn không ghi rõ đơn vị (chỉ "Thùng nhiên liệu"). Điền sau khi bạn xác nhận là lít.']
  cargo_length_mm integer [check: `cargo_length_mm > 0`]
  cargo_width_mm integer [check: `cargo_width_mm > 0`]
  cargo_height_mm integer [check: `cargo_height_mm > 0`, note: 'Nguồn có 2 phương án ("780/2100"): để NULL, phương án vào spec_extra.cargo_alternatives.']
  engine_model varchar(64) [note: 'Chuỗi nguồn đã trim. Mã động cơ KHÔNG xác định công suất (D4GA có 125 kW và 103 kW), nên không tách bảng engines.']
  power_kw numeric(7,2) [check: `power_kw > 0`]
  power_rpm smallint [check: `power_rpm > 0`, note: 'Các giá trị 260 và 600 trong nguồn nghi sai: không tự sửa, ghi data_issues.']
  torque_nm numeric(8,2) [check: `torque_nm > 0`]
  torque_rpm_min smallint [check: `torque_rpm_min > 0`]
  torque_rpm_max smallint [check: `torque_rpm_max > 0`]
  displacement_cc integer [check: `displacement_cc > 0`, note: 'Nguồn có 2.493 / 2.289: không tự đổi thành 2493 / 2289.']
  emission_standard varchar(24) [note: 'Nguồn chỉ ghi "V". Giữ "V" thay vì EURO V cho đến khi xác nhận.']
  has_scr boolean [note: 'true khi nguồn ghi SCR. "-" là NULL, không phải false.']
  gearbox_model varchar(64)
  gears_forward smallint [check: `gears_forward > 0`]
  gears_reverse smallint [check: `gears_reverse > 0`, note: 'Parse từ "Cơ khí - 06 số tiến 01 số lùi" (nhiều cách viết cùng nghĩa).']
  tire_size varchar(32) [note: 'Mã, không phải số: 8.25R20, 6.50R16/5.50R13 (trước/sau). "R" và "-" khác nhau.']
  has_abs boolean [note: 'true khi nguồn ghi "có"/"co". "-" là NULL. Dòng 71 mâu thuẫn (AQ có ABS, AR là "-"): ghi data_issues.']
  spec_extra jsonb [note: 'Đuôi dài đã parse: axles[], axle_ratio, gear_ratios[], suspension, leaf_springs, brakes, steering, cabin_width_mm, treads_mm, load_alternatives, cargo_alternatives, axle_spacings_mm. Bot hầu như không hỏi tới.']
  spec_raw jsonb [note: 'Chuỗi gốc theo tên cột nguồn, để parse lại mà không đọc lại xlsx.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    payload_kg
    gvm_kg
    wheelbase_mm
  }
}

// ============================================================
// GIÁ
// ============================================================

Table product_prices {
  id integer [pk, increment]
  product_id integer [not null, ref: > products.id]
  price_type varchar(12) [not null, default: 'MSRP', check: `price_type IN ('MSRP', 'SELLING')`, note: 'Hiện chỉ MSRP có dữ liệu. DEALER_COST / MIN_SELLING / biên lợi nhuận là dữ liệu nội bộ: không thêm vào bảng này; nếu cần, tạo bảng riêng với quyền truy cập riêng để tool/RAG của bot không đọc nhầm.']
  amount_vnd bigint [not null, check: `amount_vnd >= 0`, note: 'Đồng, không phải triệu. Nguồn ghi triệu đồng: 965,628 -> 965628000. bigint vì Integer (list_price_vnd cũ) tối đa ~2,147 tỷ, xe nặng có thể vượt.']
  basis varchar(12) [not null, default: 'UNKNOWN', check: `basis IN ('CHASSIS', 'FLATBED', 'TARP', 'COMPLETE', 'UNKNOWN')`, note: 'Cơ sở giá theo nguồn: (Chassis)=CHASSIS, (thùng lửng)=FLATBED, (mui bạt)=TARP, không ghi=UNKNOWN. Không suy từ vehicle_type.']
  basis_note varchar(120) [note: 'Chuỗi gốc, ví dụ "965,628 (Chassis)".']
  effective_date date [note: 'NULL nếu nguồn không nêu. Không dùng ngày sửa file làm ngày hiệu lực.']
  is_current boolean [not null, default: true]
  needs_review boolean [not null, default: false, note: 'true với giá lệch thang (819180, 865404, 561816, 613008) hoặc hai giá "427 (417,6) (chassis)". Bot không dùng dòng needs_review.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (product_id, price_type, is_current)
  }
  Note: '''Cần partial unique index trong migration (DBML không biểu diễn được):
  CREATE UNIQUE INDEX uq_current_price ON product_prices (product_id, price_type) WHERE is_current;
  Đảm bảo mỗi sản phẩm chỉ một giá hiện hành, để so sánh số tiền của output_guard xác định.'''
}

// ============================================================
// MEDIA, ĐỐI THỦ
// ============================================================

Table product_media {
  id integer [pk, increment]
  product_id integer [not null, ref: > products.id]
  kind varchar(10) [not null, check: `kind IN ('IMAGE', 'VIDEO', 'BROCHURE', 'SPEC', 'PRICE')`, note: 'Nguồn có "Brochure_Link" mô tả là sách hướng dẫn: xác nhận trước khi dùng BROCHURE.']
  url text [not null]
  caption text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes { (product_id, kind) }
}

Table product_competitors {
  id integer [pk, increment]
  product_id integer [not null, ref: > products.id]
  competitor_name varchar(200) [not null, note: 'Đối thủ phần lớn không nằm trong catalog (Chenglong, Howo, Shacman...), nên lưu text.']
  competitor_product_id integer [ref: > products.id, note: 'Chỉ điền khi đối thủ cũng là sản phẩm trong catalog.']
  advantage text [note: 'Lợi thế của ta so với đối thủ.']
  disadvantage text [note: 'Bất lợi của ta so với đối thủ.']
  source varchar(255)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes { product_id }
  Note: 'Chưa có dữ liệu thật (cột Competitor_* trong master rỗng); nội dung nằm ở xlsx so sánh/pptx, chưa đọc. Có thể hoãn bảng này.'
}

// ============================================================
// NGUỒN GỐC VÀ CHẤT LƯỢNG DỮ LIỆU
// ============================================================

Table catalog_sources {
  id integer [pk, increment]
  file_name varchar(255) [not null]
  sha256 char(64) [not null, unique, note: 'Phân biệt các phiên bản cùng tên file.']
  source_modified_at timestamptz [note: 'Metadata file, KHÔNG phải ngày hiệu lực giá hay năm sản xuất.']
  imported_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table product_sources {
  product_id integer [not null, ref: > products.id]
  source_id integer [not null, ref: > catalog_sources.id]
  sheet varchar(60) [not null]
  row_ref varchar(40) [not null, note: 'Master: "row:34". Ma trận Foton: "column:M" + block.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (product_id, source_id, sheet, row_ref) [pk]
    source_id
  }
  Note: 'Một product có thể có nhiều nguồn (dòng trùng 34/41; cùng model xuất hiện ở master và Foton Specs). Không khớp tự động chỉ theo tên model.'
}

Table data_issues {
  id integer [pk, increment]
  product_id integer [not null, ref: > products.id]
  field varchar(60) [not null, note: 'Tên cột đích hoặc tên cột nguồn, ví dụ axle_ratio, displacement_cc, msrp.']
  raw_value text [note: 'Giá trị gốc đã gây nghi ngờ.']
  code varchar(40) [not null, note: 'unit_ambiguous, decimal_separator, scale_suspect, duplicate_row, identity_missing, source_conflict...']
  note text [not null]
  resolution text
  resolved_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    product_id
    (code, resolved_at)
  }
}

// ============================================================
// LIÊN KẾT VỚI BẢNG VẬN HÀNH (không định nghĩa lại ở đây)
// contracts.variant_id (schema.dbml) -> contracts.product_id ref: > products.id
// appointments TODO[ĐỢT 3]: product_id ref: > products.id (thay vehicle_id / variant_id)
// Q&A CSKH, SWOT, so sánh đối thủ dạng văn xuôi -> RAG (data/knowledge, rag_chunks), không vào bảng quan hệ.
// ============================================================
