# Copy thành .env rồi chỉnh.
# LLM_PROVIDER=none: chạy rule-based, không cần key.
# LLM_PROVIDER=openai: dùng OpenAI (cần OPENAI_API_KEY).
DATABASE_URL=sqlite:///./dev.db
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
MAX_REACT_ITERATIONS=3
HANDOVER_TIMEOUT_MINUTES=10
HOTLINE=0900 000 000

# --- RAG ---
# RETRIEVER: hybrid (BM25 + vector, mặc định) | bm25 | vector | keyword (bản khung cũ)
RETRIEVER=hybrid
# EMBEDDING_PROVIDER: openai | hash (offline, không hiểu nghĩa, để test) | none. Thiếu key -> tự chạy BM25-only.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
RAG_VECTOR_STORE=local
RAG_CANDIDATES=10
RAG_RRF_K=60
RAG_WEIGHT_BM25=1.0
RAG_WEIGHT_VECTOR=1.0
# Ngưỡng chuyển người: chunk phải khớp >= N từ khóa HOẶC cosine >= ngưỡng, nếu không bot chuyển người.
# 0.35 là giá trị khởi đầu, CẦN chỉnh bằng: python -m app.rag.cli "câu hỏi"
RAG_MIN_KEYWORD_HITS=2
RAG_MIN_VECTOR_SIM=0.35
