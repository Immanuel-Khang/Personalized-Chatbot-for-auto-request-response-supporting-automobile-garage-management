# Copy thành .env rồi chỉnh.
# LLM_PROVIDER=none: chạy rule-based, không cần key.
# LLM_PROVIDER=openai: dùng OpenAI (cần OPENAI_API_KEY).
DATABASE_URL=postgresql+psycopg://garage:garage@127.0.0.1:5432/garage
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_TEMPERATURE=0.2
MAX_REACT_ITERATIONS=3
HANDOVER_TIMEOUT_MINUTES=10
HOTLINE=0900 000 000

# --- RAG ---
# RETRIEVER: hybrid (BM25 + vector, mặc định) | bm25 | vector | keyword (bản khung cũ)
RETRIEVER=hybrid
# EMBEDDING_PROVIDER: openai | hash (offline, không hiểu nghĩa, để test) | none. Thiếu key -> tự chạy BM25-only.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# RAG_VECTOR_STORE: pgvector (chunk + vector lưu trong Postgres, cần `alembic upgrade head`) | local (RAM + cache file)
RAG_VECTOR_STORE=pgvector
# RAG_LEXICAL: python (BM25 trong RAM) | pg (full-text Postgres; chỉ có tác dụng khi RAG_VECTOR_STORE=pgvector)
RAG_LEXICAL=python
RAG_CANDIDATES=10
RAG_RRF_K=60
RAG_WEIGHT_BM25=1.0
RAG_WEIGHT_VECTOR=1.0
# Ngưỡng chuyển người: chunk phải khớp >= N từ khóa HOẶC cosine >= ngưỡng, nếu không bot chuyển người.
# 0.35 là giá trị khởi đầu, CẦN chỉnh bằng: python -m app.rag.cli "câu hỏi"
RAG_MIN_KEYWORD_HITS=2
RAG_MIN_VECTOR_SIM=0.35

# --- Admin ---
# Chuỗi ngẫu nhiên dài để ký token đăng nhập admin (bắt buộc khi production / nhiều worker)
ADMIN_SECRET=
# false = tắt đăng nhập admin (chỉ dev/test)
ADMIN_AUTH_REQUIRED=true
ADMIN_TOKEN_HOURS=12
ADMIN_MAX_LOGIN_ATTEMPTS=3
ADMIN_LOCK_MINUTES=15
# Số lịch tối đa mỗi khung giờ 1 tiếng khi nhân viên xác nhận lịch hẹn
SLOT_CAPACITY=2
# Độ dài một khung giờ (phút) = khoảng cách giữa hai khung liên tiếp; lưới tính từ WORK_START
SLOT_MINUTES=60
WORK_START=08:00
WORK_END=17:00
# 4 giá trị trên chỉ là MẶC ĐỊNH: quản lý chỉnh trực tiếp ở trang /appointments.html (lưu DB, đè lên giá trị này)
